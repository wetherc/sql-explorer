{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The permissions the main window needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "store:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message"
  ]
}
